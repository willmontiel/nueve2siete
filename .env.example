# Supabase (opcional; ver docs/supabase.md). La URL del proyecto y la llave pública: la publishable
# (sb_publishable_...) o la anon. Nunca la secret ni la service_role: saltan todos los permisos.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

