// Cloudflare Workers, serving the built site as static assets (there is no Worker script). Any path that is not a
// file gets index.html, so the routes of the single-page app (/catalogo/clicker-fidget) open on a reload too.
// The build itself runs `npm run build` on Cloudflare, with Node 22 from .nvmrc (docs/despliegue.md).
{
  "name": "nueve2siete",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  }
}
