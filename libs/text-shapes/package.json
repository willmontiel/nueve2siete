{
  "name": "@nueve2siete/text-shapes",
  "version": "0.1.0",
  "private": true,
  "description": "Text and emojis to printable 2D shapes (base, relief, key ring hole) for keychains and name tags.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:emojis": "tsx scripts/build-emojis.ts"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-18",
    "opentype.js": "2.0.0"
  },
  "devDependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/noto-emoji": "5.3.2",
    "@fontsource/pacifico": "5.3.0",
    "@fontsource/titan-one": "5.3.0",
    "@nueve2siete/configurator": "workspace:*",
    "@types/node": "22.19.9",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  }
}
