# Local Postgres (pnpm db) or docker compose
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nueve2siete
# Generate one with: openssl rand -base64 24
PAYLOAD_SECRET=change-me
# Public site URL (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Files uploaded in the admin. Defaults to .data/media at the repo root; on the server, the same folder as the admin.
# MEDIA_DIR=/var/lib/nueve2siete/media

# Logo engine (apps/engine, pnpm engine). Only the server calls it.
ENGINE_URL=http://127.0.0.1:8000
